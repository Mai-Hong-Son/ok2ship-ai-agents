# backend/ and frontend/ are each their own separate git repo now (nested .git/, pushed to their
# own GitLab projects — see HANDOFF.md's "Repo topology"). This parent repo doesn't track their
# contents at all — ignoring the whole directories, not just their build artifacts, so `git add`
# here never tries to create a submodule-style gitlink entry for them.
backend/
frontend/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Claude Code's own directory: local settings, and any git worktree it creates under
# .claude/worktrees/. Ignored for the same reason as backend/ and frontend/ above — a worktree is a
# full checkout with its own .git, and `git add` here would otherwise try to record it as a
# gitlink. Ignoring it does NOT remove it: `git worktree list` still knows about it.
.claude/

